# dependencies
/node_modules
/.pnp
.pnp.js

# next
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env — old Lovable/Supabase keys are intentionally not carried over.
# `.env.*` catches migration/service-key files (.env.migrate) that `.env*.local`
# would miss — never let a connection string or key become committable.
.env
.env.*
.env*.local

# python
__pycache__/
*.pyc
.venv/
venv/

# Generated data layer — everything under data/ is produced at build time from
# Supabase (scripts/prefetch_supabase.mjs pulls the site_json table). Nothing here
# is committed: the repo is public and the data lives in Supabase. See
# supabase/migrations/, scripts/db.py, scripts/publish_site_json.py.
scripts/.cache/
/data/

# vercel
.vercel
